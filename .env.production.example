APP_NAME="ELVOA Enterprise"
APP_ENV=production
APP_KEY=base64:ecmH+t5QpyuvLSGdKDWLwRF8diQUPzmYSaT1t/Ywv5g=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
ASSET_URL=https://api.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging (Rotate logs daily to preserve disk space on cPanel)
LOG_CHANNEL=daily
LOG_LEVEL=error

# Database Configuration (Enter your cPanel MySQL DB credentials)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_elvoa
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD="your_strong_database_password"

# Session & Authentication
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Frontend & CORS Configuration (Comma-separated allowed origins)
FRONTEND_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com
SANCTUM_STATEFUL_DOMAINS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# Cache & Queue Drivers
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail Configuration (cPanel Webmail or SendGrid/Resend SMTP)
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD="your_email_password"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# SSLCOMMERZ Live Payment Gateway Configuration
SSLCZ_STORE_ID=your_live_store_id
SSLCZ_STORE_PASSWORD=your_live_store_password
SSLCZ_TESTMODE=false

