<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to hidden files and .env
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Rewrite all requests to public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

